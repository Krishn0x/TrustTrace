# TrustTrace Configuration
# Algorand Testnet address to receive payments for paid analyses
AVM_ADDRESS=DEMO_WALLET_ADDRESS

# GoPlausible Facilitator URL
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Client E2E Test Credentials (NEVER commit the real values!)
# You can provide EITHER the mnemonic (25-word Pera Wallet recovery phrase) OR the base64 private key.
# It is recommended to use X402_CLIENT_MNEMONIC.
X402_CLIENT_MNEMONIC=word1 word2 word3 ... word25
# X402_CLIENT_PRIVATE_KEY=your_testnet_private_key_base64_here
